// Sin `output` propio a propósito: si el cliente generado cae dentro de src/,
// Turbopack termina trazando todo el proyecto y lo mete en el bundle del server.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // El sitio entra por el pooler, que aguanta muchas visitas a la vez.
  url      = env("DATABASE_URL")
  // Las migraciones necesitan la conexión directa: no funcionan por el pooler.
  directUrl = env("DIRECT_URL")
}

model Event {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  date      DateTime
  location  String?
  /// Deporte del partido/evento, para agrupar en la portada. Libre a propósito:
  /// no hay un enum cerrado de disciplinas.
  category  String?
  /// Precio por foto en pesos enteros. Cada evento puede tener el suyo.
  priceArs  Int      @default(2500)
  /// Precio fijo por todas las fotos del evento. Si está cargado, en el carrito
  /// se ofrece como alternativa a comprarlas sueltas con descuento por cantidad.
  packPriceArs Int?
  published Boolean  @default(false)
  coverKey  String?
  createdAt DateTime @default(now())

  photos Photo[]

  @@index([published, date])
}

model Photo {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// Código corto que el fotógrafo le pasa al jugador para que encuentre la foto.
  code String @unique

  /// Claves en el bucket. El original vive en el prefijo privado y nunca se sirve.
  originalKey String
  previewKey  String
  thumbKey    String

  width      Int
  height     Int
  sizeBytes  Int
  originalName String

  camera  String?
  lens    String?
  takenAt DateTime?

  /// Nombre del equipo al que se le separó esta foto, si el partido tiene más
  /// de uno. Texto libre como `Event.category`: cada partido usa los nombres
  /// que corresponda, no hay una lista cerrada.
  equipo String?

  createdAt DateTime @default(now())

  orderItems OrderItem[]

  @@index([eventId, takenAt])
  @@index([eventId, equipo])
}

model Order {
  id String @id @default(cuid())

  /// Secreto que va en la URL de descarga y en el mail. Es la llave del comprador.
  token String @unique

  email     String
  buyerName String?

  /// El Instagram del comprador, si quiso dejarlo. Es opcional a propósito: las
  /// fotos llegan igual por mail, así que pedirlo como obligatorio sería un
  /// obstáculo más antes de pagar. Sirve para etiquetarlo cuando Santi publica.
  instagram String?

  /// "PENDING" | "PAID" | "FAILED" — ver OrderStatus en src/lib/orders.ts
  status   String @default("PENDING")
  totalArs Int

  /// "mercadopago" | "transferencia"
  metodoPago String @default("mercadopago")

  mpPreferenceId String?
  mpPaymentId    String?

  /// Cuándo el comprador tocó "Ya transferí" y se lo mandamos a avisar por
  /// WhatsApp. Sirve para que el panel muestre quién ya avisó y para no
  /// borrar sola una orden que alguien dice haber pagado.
  avisoTransferenciaEn DateTime?

  createdAt DateTime  @default(now())
  paidAt    DateTime?

  items OrderItem[]

  @@index([status, createdAt])
}

/// Marca de agua subida a mano desde el panel. Si no hay fila para un slot, se
/// usa el archivo de la carpeta assets/ que viene con el proyecto.
///
/// Va en la base y no en el disco porque en producción el sistema de archivos
/// es de solo lectura: el archivo en sí vive en el bucket privado.
model Watermark {
  /// "mosaico" (el que se repite) o "centro" (la marca grande del medio).
  slot       String   @id
  storageKey String
  mime       String
  filename   String
  updatedAt  DateTime @updatedAt
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  photoId String
  photo   Photo  @relation(fields: [photoId], references: [id], onDelete: Restrict)

  /// Precio congelado al momento de la compra: si después subís el precio del
  /// evento, la orden vieja no cambia.
  priceArs Int

  @@unique([orderId, photoId])
}

/// Perillas sueltas del sitio, guardadas como texto. Cada ajuste nuevo es una
/// fila y no una columna, así sumar una opción no obliga a migrar la base.
model Ajuste {
  clave String @id
  valor String
}

/// Cuántas veces se intentó algo que se puede adivinar a la fuerza —la
/// contraseña del panel, el PIN de una entrega— o abusar —crear órdenes—, por
/// dirección y en una ventana de tiempo. Vive en la base y no en la memoria
/// del servidor porque en Vercel cada pedido puede caer en una máquina
/// distinta: un contador en memoria se reiniciaría solo y no frenaría a nadie.
model Intento {
  clave  String   @id
  cuenta Int
  desde  DateTime
}

/// Una foto del portfolio: la selección curada que Santi muestra como carta de
/// presentación, sobre todo a organizadores y marcas.
///
/// No sale de ningún partido y **no está a la venta**, y por eso es la única
/// foto del sitio que se publica grande y sin marca de agua: su trabajo es
/// mostrar el nivel, y una marca encima no muestra nada. Se sube aparte,
/// eligiendo a mano, que es como se arma un portfolio.
model PortfolioPhoto {
  id String @id @default(cuid())

  /// El original, en el bucket privado. Nunca se sirve: está para poder rehacer
  /// las versiones publicadas si cambia alguna medida.
  originalKey String
  /// La versión grande y limpia. Es la que se ve al abrir una foto.
  key String
  /// La versión para la grilla y para la cinta de la portada.
  thumbKey String

  width  Int
  height Int

  /// Un pie opcional. Vacío no muestra nada.
  titulo String?

  /// Para ordenarlas a gusto. Menor primero.
  orden Int @default(0)

  createdAt DateTime @default(now())

  @@index([orden, createdAt])
}

/// Entrega privada a un equipo o cliente.
/// Permite compartir fotos en alta resolución vinculadas a Google Drive,
/// con galería fluida, descarga individual y protección por token o PIN.
model ClientDelivery {
  id            String   @id @default(cuid())
  slug          String   @unique
  /// Token secreto para acceso directo por Magic Link
  token         String   @unique
  title         String
  clientName    String
  date          DateTime
  location      String?
  driveUrl      String
  driveFolderId String
  pin           String?
  coverUrl      String?
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  photos  DeliveryPhoto[]
  eventos DeliveryEvent[]

  @@index([published, date])
  @@index([token])
}

model DeliveryPhoto {
  id         String         @id @default(cuid())
  deliveryId String
  delivery   ClientDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  /// ID del archivo en Google Drive
  driveFileId String
  name        String
  code        String

  width     Int @default(0)
  height    Int @default(0)
  sizeBytes Int @default(0)

  camera  String?
  lens    String?
  takenAt DateTime?

  createdAt DateTime @default(now())

  eventos DeliveryEvent[]

  @@index([deliveryId, takenAt])
}

/// Qué pasó adentro de una entrega: quién entró, qué fotos miró y qué se bajó.
///
/// **No guarda quién es nadie.** `visitante` es un número al azar que vive en
/// una cookie del navegador de cada uno; sirve sólo para distinguir a una
/// persona de otra y poder contar personas en vez de clics. No se guarda
/// dirección IP, ni nombre, ni mail: si alguien borra sus datos de navegación,
/// vuelve a figurar como una persona nueva, y está bien que así sea.
///
/// Lo que pasa adentro de Google Drive no se puede saber: Drive no nos cuenta
/// quién abre la carpeta ni qué baja desde ahí. Por eso el evento `drive` es
/// "apretó el botón que lleva a Drive" y no "entró a Drive".
model DeliveryEvent {
  id         String         @id @default(cuid())
  deliveryId String
  delivery   ClientDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  /// La foto, cuando el evento es de una foto. Queda en nulo si esa foto
  /// desaparece de Drive y la sincronización la borra; por eso al lado va el
  /// código copiado, que es lo que se lee en la lista y no se pierde nunca.
  photoId String?
  photo   DeliveryPhoto? @relation(fields: [photoId], references: [id], onDelete: SetNull)
  codigo  String?

  /// acceso | vio | redes | original | drive
  tipo      String
  visitante String
  createdAt DateTime @default(now())

  @@index([deliveryId, createdAt])
  @@index([deliveryId, tipo])
  @@index([deliveryId, photoId])
}

