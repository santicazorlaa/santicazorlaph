# Copiá este archivo a .env y completá los valores.
# .env NUNCA se sube a git.

# ---------- Base de datos ----------
# Desarrollo local (SQLite). En producción se reemplaza por la URL de Postgres.
DATABASE_URL="file:./dev.db"

# ---------- Sitio ----------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Santi Cazorla Photography"

# ---------- Panel de administración ----------
# Tu contraseña para entrar a /admin. Poné una larga.
ADMIN_PASSWORD="cambiame-por-algo-largo"
# Secreto para firmar la cookie de sesión. Generalo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# ---------- Storage (Cloudflare R2, compatible con S3) ----------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Dos buckets separados. El público sólo tiene previews con marca de agua;
# el privado guarda los originales y no se expone nunca.
R2_BUCKET_PUBLIC="santicazorlaph-previews"
R2_BUCKET_PRIVATE="santicazorlaph-originales"
# Dominio conectado al bucket público (ej: https://cdn.santicazorlaph.com)
R2_PUBLIC_URL=""

# ---------- MercadoPago ----------
# Credenciales de producción o de prueba desde
# https://www.mercadopago.com.ar/developers/panel/app
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""
