# Copiá este archivo a .env y completá los valores.
# .env NUNCA se sube a git.

# ---------- Base de datos (Postgres en Neon) ----------
# Las dos apuntan a la misma base. La primera pasa por el pooler y la usa el
# sitio; la segunda es directa y la necesitan las migraciones.
#
# En este proyecto son dos bases DISTINTAS, dentro del mismo proyecto de Neon:
# ".env" apunta a "santicazorlaph_dev" (de prueba, se puede romper sin miedo) y
# ".env.vercel" apunta a "neondb" (la real, la que usan los clientes). Antes de
# escribir acá, fijate en cuál de los dos archivos estás.
DATABASE_URL=""
DIRECT_URL=""

# ---------- Sitio ----------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Santi Cazorla Photography"

# ---------- Panel de administración ----------
# Tu contraseña para entrar a /admin. Poné una larga.
ADMIN_PASSWORD="cambiame-por-algo-largo"
# Secreto para firmar la cookie de sesión. Generalo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# ---------- Storage (Cloudflare R2, compatible con S3) ----------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Dos buckets separados. El público sólo tiene previews con marca de agua;
# el privado guarda los originales y no se expone nunca.
R2_BUCKET_PUBLIC="santicazorlaph-previews"
R2_BUCKET_PRIVATE="santicazorlaph-originales"
# Dominio conectado al bucket público (ej: https://cdn.santicazorlaph.com)
R2_PUBLIC_URL=""

# ---------- Mail al comprador (Resend) ----------
# Sin esto la compra funciona igual, pero el comprador no recibe el link: si
# cierra la pestaña, pierde el acceso a sus fotos.
RESEND_API_KEY=""
# Tiene que ser una dirección del dominio verificado en Resend.
MAIL_FROM="Santi Cazorla Photography <fotos@santicazorlaph.com>"

# ---------- MercadoPago ----------
# Credenciales de producción o de prueba desde
# https://www.mercadopago.com.ar/developers/panel/app
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""
